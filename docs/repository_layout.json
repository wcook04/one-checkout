{
  "schema": "repository_layout@2",
  "undeclared_directories": "error",
  "root_files": ["README.md", "AGENTS.md", "CONTRIBUTING.md", "SECURITY.md", "LICENSE", ".gitignore", ".editorconfig", "plugin.json"],
  "directories": {
    "skills": {"purpose": "Self-contained Agent Skill and runtime", "guide": "skills/one-checkout/SKILL.md"},
    "scripts": {"purpose": "Installation and package maintenance", "suffixes": [".py"]},
    "tests": {"purpose": "Behavior tests using unittest", "suffixes": [".py"]},
    "docs": {"purpose": "Authored package documentation and role policy", "suffixes": [".md", ".json"]},
    ".claude-plugin": {"purpose": "Claude Code plugin manifest", "suffixes": [".json"]},
    ".github": {"purpose": "Hosted CI configuration", "suffixes": [".yml", ".yaml"]}
  },
  "required_files": ["README.md", "LICENSE", "plugin.json", ".claude-plugin/plugin.json", "skills/one-checkout/SKILL.md", "skills/one-checkout/LICENSE", "skills/one-checkout/scripts/one_checkout.py", "scripts/install.py", "scripts/demo.py", "scripts/check_layout.py", "tests/test_one_checkout.py", "tests/test_install.py", "tests/test_layout.py", "docs/repository_layout.json", "docs/provenance.md", ".github/workflows/ci.yml"],
  "content_routes": {
    "README.md": ["skills/one-checkout/scripts/one_checkout.py", "scripts/install.py", "scripts/demo.py", "scripts/check_layout.py", "docs/repository_layout.json"],
    "AGENTS.md": ["skills/one-checkout/scripts/one_checkout.py", "CONTRIBUTING.md"],
    ".github/workflows/ci.yml": ["unittest discover -s tests", "scripts/check_layout.py"]
  },
  "exceptions": {}
}
